{
  "name": "kulturkalender",
  "version": "0.1.0",
  "private": true,
  "description": "Vad som händer på Stockholms scener, samlat på ett ställe.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "npm run check && node --test \"tests/*.test.mjs\"",
    "dev": "node scripts/preview.mjs",
    "scan": "node scanner/run.mjs",
    "scan:dry": "node scanner/run.mjs --dry-run",
    "scan:local": "node scanner/run.mjs --out data/events.json",
    "predeploy": "node scripts/predeploy.mjs"
  }
}
